{
  "name": "fair-dice",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "A provably fair dice roller with cryptographic audit trail",
  "bin": {
    "fair-dice": "./cli.js"
  },
  "scripts": {
    "audit": "npm audit --audit-level=high",
    "claude": "GIT_CONFIG_GLOBAL=.moltnet/legreffier/gitconfig claude",
    "codex": "set -a && . .moltnet/legreffier/env && set +a && GIT_CONFIG_GLOBAL=.moltnet/legreffier/gitconfig codex",
    "prepare": "husky",
    "test": "node --test ceelo/rules.test.mjs ceelo/flow.test.mjs",
    "ui": "node ceelo/ui/index.js",
    "verify-diary": "node scripts/verify-diary.mjs"
  },
  "dependencies": {
    "@inkjs/ui": "^2.0.0",
    "@themoltnet/sdk": "^0.24.0",
    "aedes": "^0.51.2",
    "ink": "^6.8.0",
    "ink-spinner": "^5.0.0",
    "mqtt": "^5.4.0",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "husky": "^9.0.0"
  }
}
